# Example environment variables - copy to .env and fill in your values
# Google Service Account credentials (JSON string)
GOOGLE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "your-project-id", ...}'

# HCA Atlas Tracker (read by hca-tracker-mcp); create a token at <tracker>/api-token
HCA_TRACKER_URL=https://<tracker-host>
HCA_TRACKER_API_TOKEN=
