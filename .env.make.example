# Example environment overrides for Makefile
# Copy this file to `.env.make` and replace the placeholder values.

# ------- Lambda image build -------
# AWS CLI profile used to build the Lambda image (needs access to fetch the
# AWS-Parameters-and-Secrets Lambda Extension layer). Env-agnostic — the build
# produces one image — so it's a single profile. Used by
# `make build-lambda-container` / `make build-all`.
LAMBDA_PROFILE=your-aws-profile

# ------- Development environment -------
DEV_AWS_ACCOUNT_ID=000000000000
DEV_REPO_NAME=your-dev-ecr-repo
DEV_LAMBDA_FUNCTION=your-dev-lambda-function
DEV_AWS_REGION=us-east-1
# AWS CLI profile for `make deploy-lambda-container` and `make invoke-lambda`.
# Separate from LAMBDA_PROFILE because dev and prod deploy to different accounts.
DEV_LAMBDA_DEPLOY_PROFILE=your-dev-aws-profile

# Dataset-validator Batch (`make batch-publish-container`, `batch-register-jd`,
# `batch-submit-job`). VCPU and MEMORY (MiB) must be a valid Fargate pair;
# EPHEMERAL_STORAGE is in GiB.
DEV_BATCH_PROFILE=your-dev-aws-profile
DEV_BATCH_AWS_REGION=us-east-1
DEV_BATCH_AWS_ACCOUNT_ID=000000000000
DEV_BATCH_ECR_REPO=your-dev-batch-ecr-repo
DEV_BATCH_JOB_DEF_NAME=your-dev-batch-job-definition
DEV_BATCH_JOB_QUEUE=your-dev-batch-job-queue
DEV_BATCH_LOG_GROUP=/aws/batch/your-dev-log-group
DEV_BATCH_EXEC_ROLE_ARN=arn:aws:iam::000000000000:role/your-dev-batch-exec-role
DEV_BATCH_TASK_ROLE_ARN=arn:aws:iam::000000000000:role/your-dev-batch-task-role
DEV_BATCH_VCPU=4
DEV_BATCH_MEMORY=16384
DEV_BATCH_EPHEMERAL_STORAGE=100

# ------- Production environment -------
PROD_AWS_ACCOUNT_ID=000000000000
PROD_REPO_NAME=your-prod-ecr-repo
PROD_LAMBDA_FUNCTION=your-prod-lambda-function
PROD_AWS_REGION=us-east-1
PROD_LAMBDA_DEPLOY_PROFILE=your-prod-aws-profile

PROD_BATCH_PROFILE=your-prod-aws-profile
PROD_BATCH_AWS_REGION=us-east-1
PROD_BATCH_AWS_ACCOUNT_ID=000000000000
PROD_BATCH_ECR_REPO=your-prod-batch-ecr-repo
PROD_BATCH_JOB_DEF_NAME=your-prod-batch-job-definition
PROD_BATCH_JOB_QUEUE=your-prod-batch-job-queue
PROD_BATCH_LOG_GROUP=/aws/batch/your-prod-log-group
PROD_BATCH_EXEC_ROLE_ARN=arn:aws:iam::000000000000:role/your-prod-batch-exec-role
PROD_BATCH_TASK_ROLE_ARN=arn:aws:iam::000000000000:role/your-prod-batch-task-role
PROD_BATCH_VCPU=4
PROD_BATCH_MEMORY=16384
PROD_BATCH_EPHEMERAL_STORAGE=100

# ------- Curation workstation (make curation-*) -------
CURATION_INSTANCE_ID=i-00000000000000000
CURATION_AWS_PROFILE=your-aws-profile
CURATION_AWS_REGION=us-east-1
